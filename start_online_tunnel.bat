@echo off
chcp 65001 > nul
title สร้างลิงก์ออนไลน์สำหรับมือถือ (Public Tunnel)

echo ====================================================================
echo 🌐 กำลังสร้างลิงก์ออนไลน์สำหรับเปิดบนมือถือ (เข้าได้ทุกที่ แม้ใช้เน็ต 4G/5G)...
echo ====================================================================

echo [1/2] กำลังเปิดระบบหลัก (start.bat)...
start "" "%~dp0start.bat"

timeout /t 4 /nobreak > nul

echo [2/2] กำลังสร้าง Public URL ด้วย LocalTunnel...
echo.
echo ====================================================================
echo 👉 เมื่อขึ้น URL ด้านล่าง (เช่น https://xxxx.loca.lt) ให้นำไปเปิดในมือถือได้ทันที!
echo ====================================================================
echo.

npx --yes localtunnel --port 5173

pause
