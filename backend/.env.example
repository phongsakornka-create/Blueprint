# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของคุณ

PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=engineering_db

# เปลี่ยนเป็นข้อความสุ่มยาวๆ ที่คาดเดายาก (ห้ามใช้ค่านี้จริงตอน production)
JWT_SECRET=change_this_to_a_long_random_secret_key

# Client ID เดียวกับที่ใส่ใน frontend/.env (VITE_GOOGLE_CLIENT_ID) — คัดลอกจาก Google Cloud Console
GOOGLE_CLIENT_ID=ใส่_Client_ID_ของคุณ.apps.googleusercontent.com
