@echo off
chcp 65001 > nul
title หยุดการทำงานระบบเบื้องหลัง

echo ====================================================================
echo 🛑 กำลังปิดการทำงานระบบเบื้องหลังทั้งหมด (Node.js & Cloudflared)...
echo ====================================================================

taskkill /F /IM node.exe >nul 2>&1
taskkill /F /IM cloudflared.exe >nul 2>&1

echo.
echo ✅ ปิดการทำงานระบบเบื้องหลังเรียบร้อยแล้วครับ!
echo ====================================================================
pause
